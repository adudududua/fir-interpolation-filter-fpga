# in project roots after GUI or simulator launches.
**/dfx_runtime.txt
**/clockInfo.txt

# Local migration diagnostics are archived under the project but are not part
# of the reproducible release payload. Selected reports/DCPs are force-added.
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/evidence/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/core_ooc/results/

# The copied project contains legacy 2018.3 screenshots/reports and an old
# bitstream. Keep the authoritative 2025.2 result set under tools instead.
/XC7A35T_interp_opt_2025.2/reports_*/

