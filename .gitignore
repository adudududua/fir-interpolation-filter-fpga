#============================================================
# Repository-root publication allowlist
#============================================================

# Keep local archives, submission material, backups and scratch folders on
# disk, but publish only the user-selected project directories below.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/audio_data/
!/images/
!/matlab_fir/
!/need/
!/XC7A35T_interp_DSP3_LUT239_2025.2/
!/XC7A35T_interp_LUTmin_df/
!/XC7A35T_interp_LUTmin218_DSP4_2025.2/
!/XC7A35T_interp_opt_2025.2/

# Large MATLAB archive copies stay local; their extracted source trees are
# already included by the allowlist and are the reproducible Git content.
/matlab_fir/*.zip

#============================================================
# Vivado generated folders
#============================================================

.agents/
.codex_xvlog_check/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/results/synth_repair_*/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/results/gui_impl_verify_*/

**/.Xil/

*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/

**/*.cache/
**/*.hw/
**/*.ip_user_files/
**/*.runs/
**/*.sim/
**/*.gen/

#============================================================
# Vivado temporary / log / journal files
#============================================================

*.jou
*.log
*.str
*.wdb
*.pb
*.backup
*.bak
*.tmp

#============================================================
# Vivado implementation intermediate files
#============================================================

*.dcp
*.rpt
*.rpx
*.xml
*.html
*.csv

#============================================================
# Simulation temporary files
#============================================================

xsim.dir/
**/xsim.dir/
*.vcd
*.saif

#============================================================
# Windows system files
#============================================================

Thumbs.db
Desktop.ini

#============================================================
# Keep important project result files
#============================================================
!README.md
!**/*.v
!**/*.sv
!**/*.vh
!**/*.xdc
!**/*.tcl
!**/*.m
!**/*.mem
!**/*.coe
!**/*.txt
!**/*.md
!**/*.bit
!**/*.png
!**/*.jpg
!**/*.jpeg

#============================================================
# All-2x V2 reproducible intermediate results
#============================================================

matlab_fir/alt_all2x_v2/*.mat
matlab_fir/alt_all2x_v2/golden/
matlab_fir/alt_all2x_v2/vivado_results/

#============================================================
# Phase 6 dedicated Vivado temporary projects
#============================================================

matlab_fir/alt_all2x_v6/vivado_work/

#============================================================
# Phase 7 reproducible MATLAB caches
#============================================================

matlab_fir/alt_all2x_v7/*.mat
matlab_fir/alt_all2x_v7/**/*.mat
matlab_fir/alt_all2x_v8/**/*.mat

#============================================================
# Phase 7 generated verification data
#============================================================

# Daily/nightly golden vectors and RTL CSV files are reproducible from
# the checked-in MATLAB generators. Keep them local to avoid committing
# tens of megabytes of generated data.
matlab_fir/alt_all2x_v7/verification/vectors/
matlab_fir/alt_all2x_v7/verification/rtl_outputs/

#============================================================
# Local competition submission materials
#============================================================

/submit/
/guide/

#============================================================
# Local preferences, backups, and review scratch data
#============================================================

/.matlab_prefs/
/_matlab_pref_temp/
/--out
/matlab_fir_save/
/tmp/
matlab_fir/national_finals/_work/
matlab_fir/national_finals/**/_work/
/README_save.md

# Vivado/DFX runtime scratch files can be regenerated and otherwise reappear
# in project roots after GUI or simulator launches.
**/dfx_runtime.txt
**/clockInfo.txt

# Local migration diagnostics are archived under the project but are not part
# of the reproducible release payload. Selected reports/DCPs are force-added.
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/evidence/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/core_ooc/results/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/_work/
/XC7A35T_interp_opt_2025.2/.three_dsp_*_sandbox/
/XC7A35T_interp_opt_2025.2/.three_dsp_*_sim/
/.v25_3dsp_*/

# Fixed-resource scans keep only their checked-in compact summary. Timestamped
# Vivado run directories, background-process markers and crash diagnostics are
# reproducible local artifacts.
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/results/3dsp_pair_*/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/results/3dsp_synth_*/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/results/cic_dsp_mode[01]_*/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/results/three_dsp_strategy_*/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/results/three_dsp_two24_*/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/*.pid
**/hs_err_pid*.dmp
**/vivado_pid*.zip

# Repository-root launcher debris must never be kept beside the project
# directories.  Vivado/XSim commands are run from timestamped result or
# _work directories; these anchored rules are a final containment guard.
/.Xil/
/-p/
/clockInfo.txt
/dfx_runtime.txt
/vivado*.jou
/vivado*.log
/tmp/

# Fixed-2-DSP experiments must keep generated sandboxes and raw Vivado runs
# below their dedicated work areas, never as source-tree or repository-root
# deliverables.  Reproducible scripts and the compact summary remain visible.
/XC7A35T_interp_opt_2025.2/.*2dsp_sandbox/
/XC7A35T_interp_opt_2025.2/.vivado_appdata/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/.Xil/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/-p/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/*_equiv_work/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/structure_experiments/results/two_dsp_*/
/XC7A35T_interp_opt_2025.2/tools/vivado_2025_2/results/20260812_205122/

# The copied project contains legacy 2018.3 screenshots/reports and an old
# bitstream. Keep the authoritative 2025.2 result set under tools instead.
/XC7A35T_interp_opt_2025.2/reports_*/
/XC7A35T_interp_DSP3_LUT239_2025.2/deliverables/
/XC7A35T_interp_DSP3_LUT239_2025.2/reports_*/
/XC7A35T_interp_LUTmin218_DSP4_2025.2/deliverables/
/XC7A35T_interp_LUTmin218_DSP4_2025.2/reports_*/

