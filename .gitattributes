* text=auto eol=crlf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.bit binary
*.dcp binary
*.png binary
*.pdf binary
*.wdb binary

# Release-v2 hashes must survive a fresh Windows checkout byte-for-byte.
matlab_fir/national_finals/release_v2/*.json text eol=lf
matlab_fir/national_finals/release_v2/*.csv text eol=crlf

# Preserve signed-off P3-J evidence byte-for-byte so SHA256SUMS remains valid
# after a fresh Windows checkout.
matlab_fir/national_finals/vivado_results/p3j_final_430lut_431ff_176slice_4dsp_2bram_reproducible/* -text

# Preserve the signed-off 424-LUT Packed-ROM evidence and its manifest hashes.
matlab_fir/national_finals/vivado_results/p3j_final_424lut_431ff_169slice_4dsp_2bram_packedrom/* -text
